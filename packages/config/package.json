    "./jest": {
      "types": "./dist/jest.config.d.ts",
      "import": "./dist/jest.config.mjs",
      "require": "./dist/jest.config.js"
    }
  },
  "devDependencies": {
    "jest": "catalog:",
    "tsup": "9.0.0",
    "typescript": "catalog:"
  }
}
