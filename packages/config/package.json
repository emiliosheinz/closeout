{
  "name": "@closeout/config",
  "version": "0.0.1",
  "private": true,
  "description": "Shared configuration for the closeout monorepo",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./biome": "./dist/biome.json",
