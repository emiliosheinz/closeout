# Single source of truth for every overridable knob.
# `./scripts/setup-env.sh` copies this file to .env and generates secrets.
# Every service in docker-compose*.yaml reads the values via ${VAR:?required}.

# Postgres
POSTGRES_DB=closeout
POSTGRES_USER=closeout
POSTGRES_PASSWORD=closeout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSL=false
# Port published on the host (127.0.0.1 only) for database tools
POSTGRES_HOST_PORT=5433

# API (reachable only inside the Docker network)
API_PORT=3000
API_HOST=0.0.0.0
# Must point at API_PORT on the `api` service
API_BASE_URL=http://api:3000
MEDIA_DIR=/data/media

# Shared secret between web and api for server-to-server calls.
# setup-env.sh fills it with a random value.
INTERNAL_API_SECRET=

# Web
WEB_PORT=3001
WEB_HOST=0.0.0.0
# Absolute origin visitors use; drives canonical URLs, link previews,
# WhatsApp messages and the Origin check on mutating requests.
PUBLIC_BASE_URL=http://localhost:3001

# Storefront shown at the public root. Created by `bin/closeout cli admin:create`
# or `bin/closeout cli seed:demo` when missing.
STORE_SLUG=nosso-desapego
STORE_NAME=Nosso Desapego
