{
  "name": "api",
  "version": "0.0.1",
  "description": "The closeout API",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome lint . --fix",
    "format:fix": "biome format . --write",
    "check:fix": "biome check . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config ./test/jest-integration.json",
    "cli": "node dist/cli/main.js",
    "migration:generate": "scripts/generate-migration.sh",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/database/connection.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/database/connection.ts",
    "migration:show": "tsx node_modules/typeorm/cli.js migration:show -d src/database/connection.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "^11.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^1.1.1",
    "pg": "^8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^0.3.29"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@closeout/config": "workspace:*",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.7",
    "@types/express": "5.0.6",
    "@types/jest": "catalog:",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.0",
    "jest": "catalog:",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  }
}
