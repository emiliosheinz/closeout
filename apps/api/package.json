{
  "name": "api",
  "version": "0.0.1",
  "description": "The closeout API",
  "private": true,
  "main": "dist/main.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nest build",
    "start:dev": "nest start --watch",
    "lint": "biome lint .",
    "format": "biome format .",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "biome lint . --fix",
    "format:fix": "biome format . --write",
    "check:fix": "biome check . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "cli": "node dist/cli/main.js",
    "migration:generate": "scripts/generate-migration.sh",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:show": "tsx node_modules/typeorm/cli.js migration:show -d src/database/data-source.ts",
    "migration:check": "tsx node_modules/typeorm/cli.js migration:generate --check -d src/database/data-source.ts src/database/migrations/Drift"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@closeout/contracts": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.79.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "cookie": "^1.1.1",
    "nestjs-pino": "5.3.1",
    "pg": "^8.20.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "^0.35.5",
    "typeorm": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@closeout/config": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "7.2.0",
    "pino-pretty": "13.2.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-loader": "9.5.7",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.19.0",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
